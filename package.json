{
  "name": "cormac",
  "version": "0.0.0",
  "private": true,
  "description": "Cormac: a multi-tenant, contract-first CRM agent platform by Serenica Digital.",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @cormac/web run build && pnpm --filter @cormac/pane run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @cormac/web run typecheck && pnpm --filter @cormac/pane run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:rls": "tsx scripts/check-rls.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check:controls": "tsx scripts/check-control-register.ts",
    "gen:env": "tsx scripts/gen-env.ts",
    "check:env": "tsx scripts/check-env.ts",
    "check:eval-fixtures": "tsx scripts/check-eval-fixtures.ts",
    "evals": "tsx evals/run.ts",
    "evals:workbook": "tsx evals/workbook-contract/run.ts",
    "evals:workbook:explore": "tsx evals/workbook-contract/explore.ts",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "k3d:up": "bash scripts/k3d/up.sh",
    "k3d:down": "bash scripts/k3d/down.sh",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push:remote": "sh -c 'test -n \"$SUPABASE_DB_URL\" || { echo \"Set SUPABASE_DB_URL to the managed project db url\" >&2; exit 1; }; supabase db push --db-url \"$SUPABASE_DB_URL\"'",
    "check:remote": "vitest run tests/integration/isolation.test.ts",
    "dev": "docker compose -f docker/compose.yaml --env-file .env up --build",
    "dev:backend": "docker compose -f docker/compose.yaml --env-file .env up --build api hermes",
    "dev:down": "docker compose -f docker/compose.yaml --env-file .env down",
    "up": "pnpm db:start && pnpm check:migrations && pnpm seed && pnpm dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@eslint/js": "^9.17.0",
    "@cormac/config": "workspace:*",
    "@cormac/contract": "workspace:*",
    "@cormac/db": "workspace:*",
    "@cormac/shared": "workspace:*",
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "exceljs": "^4.4.0",
    "jose": "^5.9.6",
    "prettier": "^3.4.2",
    "supabase": "^2.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1",
    "zod": "^3.25.76"
  }
}
