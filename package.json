{
  "name": "serenica-crm-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Serenica CRM Agent: a multi-tenant, contract-first CRM agent platform.",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @serenica/web run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @serenica/web run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:rls": "tsx scripts/check-rls.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "evals": "tsx evals/run.ts",
    "evals:workbook": "tsx evals/workbook-contract/run.ts",
    "evals:workbook:explore": "tsx evals/workbook-contract/explore.ts",
    "seed": "tsx scripts/seed.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push:remote": "sh -c 'test -n \"$SUPABASE_DB_URL\" || { echo \"Set SUPABASE_DB_URL to the managed project db url\" >&2; exit 1; }; supabase db push --db-url \"$SUPABASE_DB_URL\"'",
    "check:remote": "vitest run tests/isolation.test.ts",
    "dev": "docker compose -f docker/compose.yaml --env-file .env up --build",
    "dev:down": "docker compose -f docker/compose.yaml --env-file .env down"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@eslint/js": "^9.17.0",
    "@serenica/contract": "workspace:*",
    "@serenica/db": "workspace:*",
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "exceljs": "^4.4.0",
    "prettier": "^3.4.2",
    "supabase": "^2.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8",
    "zod": "^3.25.76"
  }
}
