{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    // Overriding paths replaces the base config's map, so the @cormac/contract
    // mapping is restated here relative to this package.
    "paths": {
      "@/*": ["./src/*"],
      "@cormac/contract": ["../../packages/contract/src/index.ts"]
    }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
