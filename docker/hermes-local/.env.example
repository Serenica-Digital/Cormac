# Headless API-server profile. No messaging platform tokens on purpose:
# gateways activate only when their token is present (ADR-025 posture).
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=change-me-local-only

# Model provider (the runtime calls Claude; ADR-013)
ANTHROPIC_API_KEY=
