# Shared image for the Node services (api, worker). The SERVICE build arg picks
# the workload at publish time (ghcr api/worker images differ only in CMD);
# the compose file overrides the command per service locally. Services run via
# tsx; no compile step is needed for the skeleton. Build context is the repo root.
FROM node:22-slim

WORKDIR /app
RUN corepack enable

# Manifests first for layer caching.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc tsconfig.base.json ./
COPY packages ./packages
COPY services ./services
COPY apps ./apps
COPY scripts ./scripts

RUN pnpm install --frozen-lockfile

ARG SERVICE=api
ENV SERVICE=${SERVICE}
# Shell form so the env var resolves at start; compose overrides this locally.
CMD pnpm --filter "@cormac/${SERVICE}" run start
