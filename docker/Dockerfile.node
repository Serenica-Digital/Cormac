# Shared image for the Node services (api, worker, runtime-stub). The compose
# file overrides the command per service. Services run via tsx; no compile step
# is needed for the skeleton. Build context is the repo root.
FROM node:22-slim

WORKDIR /app
RUN corepack enable

# Manifests first for layer caching.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc tsconfig.base.json ./
COPY packages ./packages
COPY services ./services
COPY apps ./apps
COPY scripts ./scripts

RUN pnpm install --frozen-lockfile

# Default command; compose overrides this per service.
CMD ["pnpm", "--filter", "@serenica/api", "run", "start"]
