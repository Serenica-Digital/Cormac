# Copy to .env and fill in. Never commit .env.
# Local Supabase values are printed by `pnpm db:start`.

# --- Supabase (system of record) ---
SUPABASE_URL=http://127.0.0.1:54321
# Server-only. The control plane is the only thing that may hold this. Never ship to the browser or the runtime.
SUPABASE_SERVICE_ROLE_KEY=
# Safe in the browser only because RLS enforces reach.
SUPABASE_ANON_KEY=
# Used by the control plane to verify Supabase-issued JWTs (local default below).
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# --- Control plane API ---
API_PORT=8088

# --- Agent runtime (Hermes; runtime-stub stands in locally) ---
# The control plane reaches the runtime over HTTP. The runtime holds NO database credentials.
RUNTIME_URL=http://127.0.0.1:8090
RUNTIME_PORT=8090

# --- Workbook Contract Agent spike (evals/workbook-contract, ADR-023) ---
# Only the spike uses this. Calls the Anthropic API with synthetic fixture data; never client data.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-4-8) or the run count (default 3).
# SPIKE_MODEL=claude-sonnet-4-6
# SPIKE_RUNS=3

# --- Web ---
VITE_API_URL=http://127.0.0.1:8088
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
