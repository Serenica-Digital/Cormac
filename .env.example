# Copy to .env and fill in. Never commit .env.
# Local Supabase values are printed by `pnpm db:start`.
# This file is kept in lockstep with the env manifest (@cormac/config) by
# `pnpm check:env` (ADR-034). Add a variable there, not only here.

# --- Deployment posture ---
# local | dev | prod. local keeps developer defaults; dev/prod turn on the
# fail-closed rules (no public JWT secret, required runtime/MCP creds, explicit
# CORS, JWKS-only token verification). Leave unset for local.
APP_ENV=local

# --- Supabase (system of record) ---
SUPABASE_URL=http://127.0.0.1:54321
# Server-only secret. The control plane is the only thing that may hold this.
# Never ship to the browser or the runtime. Local value: the SERVICE_ROLE_KEY
# line printed by `pnpm db:start` (or `pnpm exec supabase status -o env`).
SUPABASE_SERVICE_ROLE_KEY=
# Safe in the browser only because RLS enforces reach. Local value: the ANON_KEY
# line from the same output.
SUPABASE_ANON_KEY=
# Used by the control plane to verify Supabase-issued JWTs in local/legacy mode
# (HS256). In prod this is left UNSET: verification is JWKS-only (ADR-020/034).
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Optional: expected `iss` claim when it differs from SUPABASE_URL/auth/v1
# (set automatically by docker/compose.yaml for the in-container API).
# SUPABASE_AUTH_ISSUER=http://127.0.0.1:54321/auth/v1

# --- Managed Supabase (remote dev project, ADR-017 deployment) ---
# Used only by the remote bootstrap (db:push:remote, seed, check:remote) and the
# Juno workload env. Namespaced REMOTE_ so they never collide with the local
# stack values above. See docs/prd/deployment-setup.md.
# REMOTE_SUPABASE_URL=https://<project-ref>.supabase.co
# REMOTE_SUPABASE_ANON_KEY=
# REMOTE_SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=postgresql://postgres:...@db.<project-ref>.supabase.co:5432/postgres
# SUPABASE_DB_PASSWORD=

# --- Control plane API ---
API_PORT=8088
# CORS allowlist, comma-separated. Defaults to the local web (5174) and Excel
# pane (https 5175) origins; MUST be set to the deployed URL(s) in prod (the
# fail-closed rule rejects the localhost default there).
# CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,https://localhost:5175,https://127.0.0.1:5175

# --- Agent runtime (Hermes) ---
# The control plane reaches the runtime over HTTP. The runtime holds NO database
# credentials. RUNTIME_KIND: hermes (the product runtime, default) or stub (the
# synchronous test fixture; never the running stack).
RUNTIME_KIND=hermes
RUNTIME_URL=http://127.0.0.1:8642
# Bearer key for the Hermes Runs API (becomes API_SERVER_KEY on the runtime).
# Generate one: openssl rand -hex 24
RUNTIME_API_KEY=
# How long capture waits for an agent run to finish (default 90s).
# RUNTIME_TIMEOUT_MS=90000
# Port for the stub when running it directly (tests start their own).
RUNTIME_PORT=8090

# --- Runtime tool surface (MCP, ADR-025) ---
# The runtime's tools are served by the control plane at /mcp. The token binds
# every tool call to exactly this workspace (the seeded demo workspace id is
# stable). Disabled when unset. Generate a token: openssl rand -hex 24
MCP_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
MCP_WORKSPACE_TOKEN=

# --- SSE streaming probe (M1 pane spike, Probe A) ---
# Off by default; the GET /capture/stream route is inert unless enabled. Turn on
# only while running the spike. SSE_TICK_MS is the progress-frame cadence.
# SSE_PROBE_ENABLED=true
# SSE_TICK_MS=1000

# --- Worker ---
# WORKER_PORT=8070

# --- Anthropic API ---
# Used by the Hermes runtime (compose injects it; ADR-013) and by the Workbook
# Contract Agent eval (evals/workbook-contract, ADR-023). Synthetic data only.
# From console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=
# Optional: override the eval model (default claude-sonnet-4-6), the run count
# (default 3), or point the explore eval at a real workbook (gitignored).
# SPIKE_MODEL=claude-opus-4-8
# SPIKE_RUNS=3
# SPIKE_XLSX=/path/to/workbook.xlsx

# --- Web + Excel pane (Vite, shared root .env) ---
VITE_API_URL=http://127.0.0.1:8088
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Excel pane auth Lanes A/B only (ADR-028, REQ-044). Leave unset to run Lane 0
# (email/password) and Probes A/C/D/E with zero Azure. Set once the sign-in-only
# Entra app registration exists (see docs/runbooks/pane-sideload.md).
# VITE_ENTRA_CLIENT_ID=
# VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/common
