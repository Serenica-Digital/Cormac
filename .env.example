# Reference list of every variable, GENERATED by `pnpm gen:env` from the env
# manifest (@cormac/config). Edit the manifest, not this file; `pnpm check:env`
# fails the build if they drift. Documentation only: secret VALUES live in
# Infisical and inject via `infisical run` (ADR-035). You do not need a .env file.
# Local Supabase values are printed by `pnpm db:start`.

# --- Deployment posture ---
# Deployment posture: local | dev | prod. Prod-like turns on fail-closed
# rules.
APP_ENV=local

# --- Supabase (system of record) ---
# System of record base URL.
SUPABASE_URL=http://127.0.0.1:54321
# Expected JWT `iss` when it differs from SUPABASE_URL/auth/v1 (Docker/host
# split).
# SUPABASE_AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
# The RLS-bypassing key. Only the control plane (and bootstrap scripts)
# holds it.
# Local value: the SERVICE_ROLE_KEY line from `pnpm db:start` (or `pnpm exec
# supabase status -o env`). Never ship it to the browser or the runtime.
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe key; supplied to the api for isolation checks and to scripts.
# Local value: the ANON_KEY line from the same output.
SUPABASE_ANON_KEY=
# HS256 fallback for local only; prod verifies ES256 against the JWKS
# (ADR-020).
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# --- Managed Supabase (remote dev project, ADR-017) ---
# Managed dev project URL for the remote bootstrap. Namespaced so it never
# collides.
# REMOTE_SUPABASE_URL=https://<project-ref>.supabase.co
# Managed dev project anon key (remote bootstrap only).
# REMOTE_SUPABASE_ANON_KEY=
# Managed dev project service-role key (remote bootstrap only).
# REMOTE_SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL with embedded password for `db:push:remote`.
# SUPABASE_DB_URL=postgresql://postgres:...@db.<project-ref>.supabase.co:5432/postgres
# Managed project DB password (remote operations).
# SUPABASE_DB_PASSWORD=

# --- Control plane API ---
# Control-plane listen port.
API_PORT=8088
# Comma-separated CORS allowlist. Must be set explicitly in prod (no
# localhost default).
# CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,https://localhost:5175,https://127.0.0.1:5175

# --- Agent runtime (Hermes) ---
# Runtime dispatch: hermes (product) or stub (tests).
RUNTIME_KIND=hermes
# The Hermes Runs API endpoint.
RUNTIME_URL=http://127.0.0.1:8642
# Bearer key for the Hermes Runs API; the same value becomes API_SERVER_KEY
# on the runtime.
# Generate one: openssl rand -hex 24.
RUNTIME_API_KEY=
# Capture's wait for a terminal run.
# RUNTIME_TIMEOUT_MS=90000
# Port for the runtime stub when run directly (test fixture only).
RUNTIME_PORT=8090

# --- Runtime tool surface (MCP, ADR-025) ---
# The workspace the runtime tool token is bound to.
MCP_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
# The runtime tool-surface bearer token; the tenant binding (ADR-025/026).
# Generate one: openssl rand -hex 24.
MCP_WORKSPACE_TOKEN=

# --- SSE streaming probe (M1 pane spike, Probe A) ---
# M1 pane spike SSE probe route on/off. Off unless explicitly enabled.
# SSE_PROBE_ENABLED=true
# SSE progress-frame cadence (wall-clock).
# SSE_TICK_MS=1000

# --- Worker ---
# Worker health-endpoint port.
# WORKER_PORT=8070

# --- Anthropic API + evals ---
# Model provider key (ADR-013). Used by the Hermes runtime and the workbook
# eval.
# From console.anthropic.com -> API keys. Synthetic data only.
ANTHROPIC_API_KEY=
# Override the workbook-contract eval model.
# SPIKE_MODEL=claude-sonnet-4-6
# Override the workbook-contract eval run count.
# SPIKE_RUNS=3
# Path to a real workbook for the explore eval (synthetic/local only).
# SPIKE_XLSX=

# --- Web + Excel pane (Vite, browser) ---
# Control-plane endpoint for the browser apps.
VITE_API_URL=http://127.0.0.1:8088
# Supabase URL for the browser auth client.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Browser anon key; safe in the bundle because RLS bounds its reach.
VITE_SUPABASE_ANON_KEY=
# Excel pane Entra sign-in (Lanes A/B). Optional; unset runs Lane 0.
# VITE_ENTRA_CLIENT_ID=
# Entra authority URL for the pane sign-in lanes.
# VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/common
