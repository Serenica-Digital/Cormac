{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/tests/**/*.ts",
    "scripts/**/*.ts",
    "evals/*/scripts/**/*.ts",
    "evals/*/src/**/*.ts"
  ],
  // apps/web is a browser package (JSX, DOM libs, bundler resolution); it
  // typechecks with its own tsconfig, chained from the root typecheck script.
  "exclude": ["apps/web"]
}
