{
  "id": "capture-multi-change",
  "kind": "capture",
  "description": "One message, two changes: update Carter, create his colleague with the relationship resolved to a real record id; the human-only segment never appears.",
  "steps": [
    {
      "do": "capture",
      "utterance": "Closed the deal with Carter. Also met his colleague Susan Pierce at Bluewater, add her as a contact covering the northeast."
    }
  ],
  "assertions": [
    {
      "step": 0,
      "outcome": "proposal"
    },
    {
      "step": 0,
      "changeCount": 2
    },
    {
      "step": 0,
      "change": {
        "op": "update",
        "objectApiName": "contact",
        "targetSeed": "James Carter"
      }
    },
    {
      "step": 0,
      "change": {
        "op": "create",
        "objectApiName": "contact",
        "valuesInclude": {
          "full_name": "Susan Pierce",
          "organization": "$seed:Bluewater Holdings"
        },
        "valuesExcludeKeys": [
          "segment"
        ]
      }
    }
  ],
  "budget": {
    "maxStepWallMs": 90000,
    "minCacheRatio": 0.5,
    "metered": {
      "maxStepWallMs": 30000,
      "minCacheRatio": 0.75
    }
  }
}
