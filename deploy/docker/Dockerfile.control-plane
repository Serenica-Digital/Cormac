# Control plane (ported from archive/docker/Dockerfile.node; one service, so
# no SERVICE arg). Runs via tsx like the dev script; no compile step for the
# skeleton. Build context is the repo root:
#   docker build -f deploy/docker/Dockerfile.control-plane .
# Config is process env only (src/config.ts); nothing is baked in.
FROM node:22-slim

WORKDIR /app
RUN corepack enable

# Manifests first for layer caching. evals/* are workspace importers in the
# lockfile, so they must be present for --frozen-lockfile to resolve.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps ./apps
COPY evals ./evals
COPY scripts ./scripts

RUN pnpm install --frozen-lockfile

EXPOSE 8080
CMD ["pnpm", "--filter", "@cormac/control-plane", "run", "dev"]
